---
/**
 * Site header: wordmark plus the four nav items.
 *
 * Created:      2026-07-26
 * Last updated: 2026-07-26
 *
 * The wordmark is a plain <a>, not a heading, because each page's single <h1>
 * belongs to that page's own content.
 */
import { NAV, SITE, isCurrent } from '../site';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-mark" href="/">{SITE.name}</a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          NAV.map((item) => (
            <li>
              {/*
                aria-current is the single source of truth for "this is the
                section you are in" — the CSS underline is driven off the same
                attribute, so the visual and accessible states cannot diverge.
              */}
              <a
                href={item.href}
                aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
