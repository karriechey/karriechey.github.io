---
/**
 * Guides index.
 *
 * Created:      2026-07-26
 * Last updated: 2026-07-26
 *
 * Reverse-chronological, tag-filtered, tightly stacked. Title, one-line
 * summary, date, tags — and NO excerpt. An auto-generated first paragraph of a
 * reference document tells a reader nothing about whether the answer they need
 * is inside it, so the hand-written `summary` does that job alone.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagFilter from '../../components/TagFilter.astro';
import { formatDate, isoDate } from '../../site';

// Drafts never appear in a listing.
const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Union of every tag in use, alphabetical, for the filter buttons.
const allTags = [...new Set(guides.flatMap((g) => g.data.tags))].sort();
---

<BaseLayout
  title="Guides"
  description="Long-form technical reference articles on quantum error correction, linear algebra and machine learning."
>
  <div class="shell">
    <header class="page-head">
      <h1>Guides</h1>
      <p class="lede measure">
        Reference articles I wrote to understand something properly, then kept
        because they turned out to be useful to look things up in. Each one is
        self-contained — there is no order to read them in.
      </p>
    </header>

    {allTags.length > 0 && <TagFilter tags={allTags} label="Filter guides by tag" />}

    <ul class="entry-list">
      {
        guides.map((guide) => (
          /* data-tags is what the filter script reads; the pipe separator is
             safe because tags are lowercase words. */
          <li class="entry" data-tags={guide.data.tags.join('|')}>
            <h2 class="entry__title">
              <a href={`/guides/${guide.id}/`}>{guide.data.title}</a>
            </h2>
            <p class="entry__summary">{guide.data.summary}</p>
            <div class="entry__meta">
              <time class="meta" datetime={isoDate(guide.data.date)}>
                {formatDate(guide.data.date)}
              </time>
              {guide.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </li>
        ))
      }
    </ul>

    {guides.length === 0 && <p class="lede">No guides published yet.</p>}
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: var(--space-3);
  }

  /* The guide index is a dense reference list, so entries sit closer together
     than the default .entry padding used elsewhere. */
  .entry-list .entry {
    padding-block: 1.15rem;
  }
</style>
